    },
    "compatibility_entry": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "platform": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "architecture": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "os_version": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "supported": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "tested": {
          "type": "boolean"
        },
        "recommended": {
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/definitions/evidence_list"
        }
      },
      "required": [
        "provider",
        "platform",
        "supported"
      ]
    },
    "versions": {
      "type": "object",
      "properties": {
        "latest": {
          "type": "string"
        },
        "minimum": {
          "type": "string"
        },
        "latest_lts": {
          "type": "string"
        },
        "latest_minimum": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/definitions/evidence_list"
        }
      }
    },
    "security_metadata": {
      "type": "object",
      "properties": {
        "cve_exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "security_contact": {
          "type": "string"
        },
        "vulnerability_disclosure": {
          "type": "string"
        },
        "sbom_url": {
          "type": "string"
        },
        "signing_key": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/definitions/evidence_list"
        }
      }
    },
    "urls": {
      "type": "object",
      "properties": {
        "website": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "issues": {
          "type": "string"
        },
        "support": {
          "type": "string"
        },
        "download": {
          "type": "string"
        },
        "changelog": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "sbom": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/definitions/evidence_list"
        }
      }
    },
    "kubernetes_artifact": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "repository": { "type": "string" },
        "chart": { "type": "string" },
        "evidence": { "$ref": "#/definitions/evidence_list" }
      },
      "required": ["name", "publisher", "version", "source", "digest"],
      "additionalProperties": false
    },
    "command_node": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "subcommands": {
          "type": "array",
          "items": { "$ref": "#/definitions/command_node" }
        },
        "flags": {
          "type": "array",
          "items": { "$ref": "#/definitions/command_flag" }
        },
        "positionals": {
          "type": "array",
          "items": { "$ref": "#/definitions/command_positional" }
        },
        "evidence": { "$ref": "#/definitions/evidence_list" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "command_flag": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "value_type": { "enum": ["string", "integer", "number", "boolean", "enum"] },
        "description": { "type": "string" },
        "evidence": { "$ref": "#/definitions/evidence_list" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "command_positional": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value_type": { "enum": ["string", "integer", "number", "boolean", "enum"] },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "evidence": { "$ref": "#/definitions/evidence_list" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "setting": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "integer", "number", "boolean", "enum"] },
        "scope": { "enum": ["file", "runtime_command", "environment", "flag"] },
        "file": { "type": "string", "minLength": 1 },
        "change_effect": { "enum": ["immediate", "reload", "restart"] },
        "defaults": {
          "type": "array",
          "items": { "$ref": "#/definitions/setting_default" }
        },
        "evidence": { "$ref": "#/definitions/evidence_list" }
      },
      "required": ["key", "type", "scope"],
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "file" } }, "required": ["scope"] },
          "then": { "required": ["file"] }
        }
      ],
      "additionalProperties": false
    },
    "setting_default": {
      "type": "object",
      "properties": {
        "value": { "type": ["string", "number", "boolean", "null"] },
        "as_of_version": { "type": "string", "minLength": 1 },
        "before_version": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/definitions/evidence_list" }
      },
      "required": ["value", "as_of_version"],
      "additionalProperties": false
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "purl": { "type": "string", "minLength": 1 },
        "cpe": { "type": "string", "minLength": 1 },
        "repology": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/definitions/evidence_list" }
      },
      "additionalProperties": false
    },
    "license_entry": {
      "type": "object",
      "properties": {
        "spdx_id": { "type": "string", "minLength": 1, "not": { "const": "NOASSERTION" } },
        "name": { "type": "string", "minLength": 1 },
        "as_of_version": { "type": "string", "minLength": 1 },
        "before_version": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/definitions/evidence_list" }
      },
      "required": ["as_of_version"],
      "anyOf": [
        { "required": ["spdx_id"] },
        { "required": ["name"] }
      ],
      "additionalProperties": false
    },
    "evidence_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/evidence_entry"
      }
    },
    "evidence_entry": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "capture",
            "primary_source",
            "scenario_step"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "span": {
          "type": "string"
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string"
        },
        "image_digest": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "version",
        "date"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "scenario_step"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "step"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
